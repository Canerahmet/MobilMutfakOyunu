<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The content-loading layer, .NET side.
    The source is under unity/Assets/Lokanta/Content; it is linked from here.

    docs/23-core-contract.md 6.1: Newtonsoft is in THIS assembly ONLY. On the
    Unity side its counterpart is the com.unity.nuget.newtonsoft-json package
    and the precompiledReferences entry in the asmdef.
  -->

  <!--
    TWO TARGETS, ONE SOURCE.

      netstandard2.1  THE GUARD. This is Unity's API surface; if the core
                      steps outside it the build breaks here. It is never
                      LOADED, only compiled.
      net10.0         The assembly the tests and the balance tool load.

    Why both: Smart App Control is in ENFORCED mode on this machine
    (Windows 11, CI policy {0283ac0f-...}) and it blocks an unsigned
    netstandard2.1 assembly from LOADING - while the net10.0 one, in the
    same folder and just as unsigned, loads without complaint. Measured:
    every time the core changed, 206 of 213 tests threw
    FileLoadException (0x800711C7) and the balance tool did not run at
    all. It was not a code error; only the target framework.

    Dropping to a single target is tempting and both are needed: moving
    to net10.0 removes the guard and the core quietly starts using an API
    Unity does not have; staying on netstandard2.1 means nothing can be
    run on this machine.
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Lokanta.Content</AssemblyName>
    <RootNamespace>Lokanta.Content</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\unity\Assets\Lokanta\Content\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lokanta.Core\Lokanta.Core.csproj" />
  </ItemGroup>

</Project>
