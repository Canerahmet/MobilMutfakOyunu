<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cekirdek simulasyon, .NET tarafi.

    KAYNAK BURADA DEGIL. Dosyalar unity/Assets/Lokanta/Core altinda duruyor ve
    bu proje onlari BAGLAYARAK derliyor. Tek kaynak, iki derleyici:
      - Unity, Lokanta.Core.asmdef ile derler (noEngineReferences: true)
      - dotnet, bu csproj ile derler ve testler saniyeler icinde kosar

    Neden Assets altinda: asmdef'teki noEngineReferences bayragi "cekirdek
    Unity'yi bilmez" kuralini DERLEYICI seviyesinde zorluyor. Klasor
    yerlesiminden daha guclu bir garanti.

    Neden bin/obj burada: Unity, Assets altindaki her dosya icin .meta uretir.
    Ara derleme ciktilarini oraya birakmak projeyi kirletirdi.
  -->

  <!--
    IKI HEDEF, TEK KAYNAK.

      netstandard2.1  KORUMA. Unity'nin API yuzeyi bu; cekirdek onun
                      disina cikarsa derleme burada kirilir. Hicbir
                      zaman YUKLENMIYOR, yalnizca derleniyor.
      net10.0         TESTLERIN VE DENGE ARACININ yukledigi derleme.

    Neden ikisi: bu makinede Smart App Control ZORUNLU modda (Windows
    11, CI politikasi {0283ac0f-...}) ve imzasiz bir netstandard2.1
    derlemesinin YUKLENMESINI engelliyor - net10.0 olani ayni klasorde,
    ayni sekilde imzasiz, sorunsuz yukleniyor. Olculdu: cekirdek her
    degistiginde 213 testin 206'si FileLoadException veriyordu
    (0x800711C7) ve denge araci hic calismiyordu. Kod hatasi degildi;
    yalniz hedef cercevesi.

    Tek hedefe donmek cazip ama ikisi de gerekli: net10.0'a gecmek
    korumayi kaldirir ve cekirdek sessizce Unity'de olmayan bir API
    kullanmaya baslar; netstandard2.1'de kalmak bu makinede hicbir seyi
    kosturamamak demek.
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Lokanta.Core</AssemblyName>
    <RootNamespace>Lokanta.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\unity\Assets\Lokanta\Core\**\*.cs" />
    <!--
      Kat plani. unity/Assets/Lokanta/Game altinda ama UnityEngine'e
      bagli DEGIL, ve testlerin onu dogrulamasi gerekiyor: odalarin
      arsayi tam kapladigini bugune kadar yalnizca editor betigi
      kontrol ediyordu, yani plan ancak Unity acilinca sinaniyordu.
    -->
    <Compile Include="..\..\unity\Assets\Lokanta\Game\RoomPlan.cs" />
  </ItemGroup>

</Project>
