<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The core simulation, .NET side.

    THE SOURCE IS NOT HERE. The files live under
    unity/Assets/Lokanta/Core and this project compiles them BY LINK. One
    source, two compilers:
      - Unity compiles it through Lokanta.Core.asmdef (noEngineReferences: true)
      - dotnet compiles it through this csproj, and the tests run in seconds

    Why it lives under Assets: the asmdef's noEngineReferences flag enforces
    the "the core does not know Unity" rule at the COMPILER level. That is a
    stronger guarantee than a folder layout.

    Why bin/obj are here: Unity generates a .meta file for everything under
    Assets. Leaving intermediate build output there would litter the project.
  -->

  <!--
    TWO TARGETS, ONE SOURCE.

      netstandard2.1  THE GUARD. This is Unity's API surface; if the core
                      steps outside it the build breaks here. It is never
                      LOADED, only compiled.
      net10.0         The assembly the tests and the balance tool load.

    Why both: Smart App Control is in ENFORCED mode on this machine
    (Windows 11, CI policy {0283ac0f-...}) and it blocks an unsigned
    netstandard2.1 assembly from LOADING - while the net10.0 one, in the
    same folder and just as unsigned, loads without complaint. Measured:
    every time the core changed, 206 of 213 tests threw
    FileLoadException (0x800711C7) and the balance tool did not run at
    all. It was not a code error; only the target framework.

    Dropping to a single target is tempting and both are needed: moving
    to net10.0 removes the guard and the core quietly starts using an API
    Unity does not have; staying on netstandard2.1 means nothing can be
    run on this machine.
  -->
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Lokanta.Core</AssemblyName>
    <RootNamespace>Lokanta.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\unity\Assets\Lokanta\Core\**\*.cs" />
    <!--
      The floor plan. It sits under unity/Assets/Lokanta/Game but does NOT
      depend on UnityEngine, and the tests need to verify it: until now the
      only thing checking that the rooms cover the plot exactly was an editor
      script, so the plan was tested only when Unity was open.
    -->
    <Compile Include="..\..\unity\Assets\Lokanta\Game\RoomPlan.cs" />
  </ItemGroup>

</Project>
