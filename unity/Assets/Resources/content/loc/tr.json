  "regular.burak.beat1": "Bilgisayarını açıyor, siparişi bekletmeden söylüyor.",
  "regular.burak.beat2": "“Ekip öğle yemeğini buraya taşıdık.”",
  "regular.burak.beat3": "“Uzaktan çalışacağım ama burası ofisim sayılır.”",
  "regular.burak.job": "Yazılımcı",
  "regular.burak.name": "Burak",
  "regular.cem_abi.beat1": "Motoru kapının önünde, kaskı elinde.",
  "regular.cem_abi.beat2": "“Kuryeler grubuna yazdım sizi.”",
  "regular.cem_abi.beat3": "“Kendi dükkânımı açıyorum. Sizden öğrendim bu işi.”",
  "regular.cem_abi.job": "Motokurye",
  "regular.cem_abi.name": "Cem Abi",
  "regular.deniz.beat1": "Servis çıkışı, sırt çantası omzunda, acelesi var.",
  "regular.deniz.beat2": "“Arkadaşlarla buluşma yeri burası oldu.”",
  "regular.deniz.beat3": "Sınavı kazanmış. “Kutlama burada, altı kişiyiz.”",
  "regular.deniz.job": "Lise öğrencisi",
  "regular.deniz.name": "Deniz",
  "regular.elif.beat1": "Alışveriş poşetleriyle geliyor, on beş dakikası var.",
  "regular.elif.beat2": "“Vitrinden gördüm, yeni bir şey eklemişsiniz.”",
  "regular.elif.beat3": "“Mağazadaki kızlara da söyledim. Sizden alıyoruz artık.”",
  "regular.elif.job": "Mağaza satış danışmanı",
  "regular.elif.name": "Elif",
  "regular.guler_hanim.beat1": "Ayaküstü geliyor, pilavı paket istiyor.",
  "regular.guler_hanim.beat2": "“Müşterilerime de söylüyorum, karşıya gidin diye.”",
  "regular.guler_hanim.beat3": "Dükkânını büyütüyor. “Sizinle beraber büyüdük yani.”",
  "regular.guler_hanim.job": "Köşedeki kuaför",
  "regular.guler_hanim.name": "Güler Hanım",
  "regular.hasan_usta.beat1": "Kapıdan girer girmez mutfağa bakıyor. “Fasulye var mı?”",
  "regular.hasan_usta.beat2": "Artık siparişini söylemiyor. Oturuyor, sen biliyorsun.",
  "regular.hasan_usta.beat3": "“Oğlum askerden geldi, akşam onu da getireceğim.”",
  "regular.hasan_usta.job": "Karşı sokakta tornacı",
  "regular.hasan_usta.name": "Hasan Usta",
  "regular.ismail_sofor.beat1": "Kamyonu köşeye çekiyor, hızlı yiyip çıkıyor.",
  "regular.ismail_sofor.beat2": "“Ankara dönüşü hep buraya uğruyorum artık.”",
  "regular.ismail_sofor.beat3": "Telsizde anlatmış: “İki şoför arkadaş daha soracak sizi.”",
  "regular.ismail_sofor.job": "Uzun yol kamyon şoförü",
  "regular.ismail_sofor.name": "İsmail Şoför",
  "regular.kaan_hoca.beat1": "Antrenman sonrası, protein soruyor.",
  "regular.kaan_hoca.beat2": "“Öğrencilerime buradan yemelerini söylüyorum.”",
  "regular.kaan_hoca.beat3": "“Salonun panosuna astım adresinizi. Umarım sorun olmaz.”",
  "regular.kaan_hoca.job": "Spor salonu antrenörü",
  "regular.kaan_hoca.name": "Kaan Hoca",
  "regular.mehmet_dede.beat1": "Kapıda duraklıyor. “Burası eskiden başkasınındı.”",
  "regular.mehmet_dede.beat2": "“O zamanki nohut da böyleydi. Aynı.”",
  "regular.mehmet_dede.beat3": "Her gün geliyor artık. Sandalyesi belli oldu.",
  "regular.mehmet_dede.job": "Eski lokanta müdavimi",
  "regular.mehmet_dede.name": "Mehmet Dede",
  "regular.melis.beat1": "Fiyat listesini baştan sona okuyor.",
  "regular.melis.beat2": "“Hesabı ben tutarım, siz yemeği yapın.”",
  "regular.melis.beat3": "“Kâr marjınızı merak ediyorum. Şaka değil.”",
  "regular.melis.job": "Serbest muhasebeci",
  "regular.melis.name": "Melis",
  "regular.nazife_teyze.beat1": "Çorbayı tadıyor, bir şey demiyor. Yarın yine geliyor.",
  "regular.nazife_teyze.beat2": "“Benim mercimeğim de böyle olurdu, eskiden.”",
  "regular.nazife_teyze.beat3": "Kapıda duruyor: “Burası mahallenin yüzü oldu.”",
  "regular.nazife_teyze.job": "Üst kattaki komşu",
  "regular.nazife_teyze.name": "Nazife Teyze",
  "regular.nurten_abla.beat1": "Molası kısa. Cacığı hep yanında götürüyor.",
  "regular.nurten_abla.beat2": "“Atölyeden üç kişi daha gelecek, yer ayırın.”",
  "regular.nurten_abla.beat3": "Atölye kapanıyor. “Yeni yerim uzak ama yine gelirim.”",
  "regular.nurten_abla.job": "Tekstil atölyesinde usta",
  "regular.nurten_abla.name": "Nurten Abla",
  "regular.okan.beat1": "En ucuz ne varsa onu soruyor.",
  "regular.okan.beat2": "“Burs yattı.” Bugün tatlı da alıyor.",
  "regular.okan.beat3": "Staja başlıyor. “İlk maaşımda buradan ısmarlayacağım.”",
  "regular.okan.job": "Üniversite öğrencisi",
  "regular.okan.name": "Okan",
  "regular.ozan.beat1": "Maç sonrası, takımıyla birlikte, gürültülü.",
  "regular.ozan.beat2": "“Kazanınca buraya geliyoruz. Uğurlu oldunuz.”",
  "regular.ozan.beat3": "“Kupayı aldık. Formaya adınızı yazdıralım mı?”",
  "regular.ozan.job": "Amatör futbolcu",
  "regular.ozan.name": "Ozan",
  "regular.perihan_hanim.beat1": "Çatalı ışığa tutuyor. Bir şey demiyor ama bakıyor.",
  "regular.perihan_hanim.beat2": "“Masa örtüsü bugün temiz. Fark ettim.”",
  "regular.perihan_hanim.beat3": "“Ben kolay beğenmem. Burayı beğendim.”",
  "regular.perihan_hanim.job": "Emekli öğretmen",
  "regular.perihan_hanim.name": "Perihan Hanım",
  "regular.rasim_amca.beat1": "Elleri kireçli. Oturmadan önce ceketini silkeliyor.",
  "regular.rasim_amca.beat2": "“Çocuklara da söyledim, öğle yemeği burada.”",
  "regular.rasim_amca.beat3": "Şantiye bitiyor. “Ama ben yine uğrarım, merak etme.”",
  "regular.rasim_amca.job": "Şantiye ustabaşı",
  "regular.rasim_amca.name": "Rasim Amca",
  "regular.selim_bey.beat1": "Aynı masa, aynı saat. Bir dakika şaşmıyor.",
  "regular.selim_bey.beat2": "“Öğle molam kırk dakika. Sizde otuz beşte kalkıyorum.”",
  "regular.selim_bey.beat3": "Emekliliğini konuşuyor. “O zaman daha çok gelirim.”",
  "regular.selim_bey.job": "Vergi dairesinde memur",
  "regular.selim_bey.name": "Selim Bey",
  "regular.sevda.beat1": "Salatayı soruyor: “Sosu ayrı olur mu?”",
  "regular.sevda.beat2": "“Danışanlarıma buradan öneri veriyorum.”",
  "regular.sevda.beat3": "“Menünüzü kliniğin duvarına astım.”",
  "regular.sevda.job": "Diyetisyen",
  "regular.sevda.name": "Sevda",
  "regular.tolga.beat1": "Gece yarısı geliyor. Kapının açık olmasına şaşırıyor.",
  "regular.tolga.beat2": "“Sabahın körü açık olan tek yer sizsiniz.”",
  "regular.tolga.beat3": "“Vardiya arkadaşları da gelmeye başladı, fark ettiniz mi?”",
  "regular.tolga.job": "Gece vardiyası güvenlik",
  "regular.tolga.name": "Tolga",
  "regular.yagmur.beat1": "Geç saatte, yorgun. Tatlı soruyor.",
  "regular.yagmur.beat2": "“Günün tek keyifli anı burası oluyor.”",
  "regular.yagmur.beat3": "“Kursu bitirdim. Ama alışkanlık yaptı, geleceğim.”",
  "regular.yagmur.job": "Gece dersi öğretmeni",
  "regular.yagmur.name": "Yağmur",
